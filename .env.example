# Copy to .env and fill in values. Never commit .env.

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."

# JWT (required — used for login cookies and API auth)
JWT_SECRET="generate-a-long-random-string"

# Google Gemini (moderation, mood, prompts, reflections)
GEMINI_API_KEY=""

# Cron jobs (optional — weekly reflection, daily prompt)
CRON_SECRET=""

# Email verification (signup / login OTP). Without SMTP, codes log to the server console in dev.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Folio BU <noreply@bennett.edu.in>"
