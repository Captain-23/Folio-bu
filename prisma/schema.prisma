// Prisma schema for Supabase PostgreSQL.
// Run: npx prisma db push  (dev)
//      npx prisma migrate deploy  (production)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")      // connection pooling URL
  directUrl = env("DIRECT_URL")        // direct URL for migrations only
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  ADMIN
}

enum Mood {
  hopeful
  exhausted
  anxious
  grateful
  nostalgic
  numb
  frustrated
  content
}

// ─── MODELS ───────────────────────────────────────────────────────────────────

model User {
  // Stores credentials and permanent alias.
  // The email is never sent to the client — only alias is exposed.
  id                 String             @id @default(cuid())
  email              String             @unique
  password           String             // bcrypt hashed — never plain text
  alias              String?            @unique // chosen pseudonym after signup
  avatarId           String?            // one of 8 non-human avatars
  onboardingComplete Boolean            @default(false)
  role               Role               @default(STUDENT)
  createdAt          DateTime           @default(now())

  entries          Entry[]
  reactions        Reaction[]
  weeklyReflection WeeklyReflection[]
}

model Entry {
  // Core journal entry.
  // userId is stored privately; the feed query uses a Prisma select
  // that returns ONLY alias from the User join — never email or userId.
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  content      String    @db.VarChar(1000)
  mood         Mood?                        // set async by AI pipeline; null until processed
  aiReflection String?                      // set async by AI pipeline
  isPublished  Boolean   @default(false)    // stays false until moderation passes
  isFlagged    Boolean   @default(false)    // true if moderation flagged for review
  flagReason   String?                      // reason returned by Gemini moderation
  createdAt    DateTime  @default(now())

  reactions Reaction[]

  @@index([userId])
  @@index([isPublished, createdAt])  // feed query optimisation
}

model Reaction {
  // Anonymous "Felt this" counter.
  // userId is stored for uniqueness enforcement only —
  // it is never returned in API responses.
  id      String @id @default(cuid())
  entryId String
  userId  String
  entry   Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([entryId, userId])   // prevents double-reacting
}

model DailyPrompt {
  // One prompt per day, generated by Gemini at 6:00 AM via cron.
  // All users see the same prompt on a given day.
  id        String   @id @default(cuid())
  prompt    String
  date      DateTime @unique @db.Date
  createdAt DateTime @default(now())
}

model WeeklyReflection {
  // AI-generated private summary of a user's last 7 entries.
  // Generated every Sunday midnight. Only visible to the owner.
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  weekStart DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([userId, weekStart])
}
